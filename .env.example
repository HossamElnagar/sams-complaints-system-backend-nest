# Application Port
PORT=3000

# MongoDB Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/sadat-ticketing-service

# JWT Secret Key (Minimum 32 characters recommended)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here

# Initial Super Admin Seed Credentials
SUPER_ADMIN_NAME=System_Administrator
SUPER_ADMIN_EMAIL=admin@academy.edu
SUPER_ADMIN_PASSWORD=change_this_secure_password
SUPER_ADMIN_ROLE=SUPER_ADMIN

# External AI FastAPI Microservices
AI_SUMMARIZE_URL=http://127.0.0.1:8001/summarize
AI_CLASSIFY_ROUTE_URL=http://127.0.0.1:8002/classify-route
AI_CONSUMER_ENABLED=true
AI_POLL_INTERVAL_MS=5000
AI_SERVICE_MOCK=false
AI_TIMEOUT_MS=10000
